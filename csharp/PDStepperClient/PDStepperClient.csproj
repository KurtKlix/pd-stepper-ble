<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>PDStepper</RootNamespace>
    <AssemblyName>PDStepperClient</AssemblyName>
    <Version>1.0.0</Version>
    <Description>C# client library for the PD-Stepper BLE API service</Description>
  </PropertyGroup>

  <!-- System.ServiceProcess is Windows-only; conditionally include -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

</Project>
